<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Mona Mayhem</title>
	</head>
	<body>
		<main class="battle-page">
			<button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false">
				Switch to Blue/Orange Theme
			</button>
			<h1>Mona Mayhem</h1>
			<p>Welcome to Mona Mayhem! Time to build a GitHub Contribution Battle Arena.</p>
		</main>

		<script>
			const root = document.documentElement;
			const button = document.getElementById('theme-toggle');
			const storageKey = 'battle-theme';

			const applyTheme = (theme) => {
				const isAlt = theme === 'blue-orange';
				if (isAlt) {
					root.setAttribute('data-theme', 'blue-orange');
				} else {
					root.removeAttribute('data-theme');
				}

				if (button instanceof HTMLButtonElement) {
					button.setAttribute('aria-pressed', String(isAlt));
					button.textContent = isAlt
						? 'Switch to Green/Purple Theme'
						: 'Switch to Blue/Orange Theme';
				}
			};

			const savedTheme = localStorage.getItem(storageKey);
			applyTheme(savedTheme ?? 'default');

			if (button instanceof HTMLButtonElement) {
				button.addEventListener('click', () => {
					const nextTheme = root.getAttribute('data-theme') === 'blue-orange' ? 'default' : 'blue-orange';
					localStorage.setItem(storageKey, nextTheme);
					applyTheme(nextTheme);
				});
			}
		</script>
	</body>
</html>

<style>
	:root {
		--bg: #0a0a1a;
		--panel: rgba(12, 12, 32, 0.92);
		--text: #f5f7ff;
		--accent-primary: #5fed83;
		--accent-secondary: #8a2be2;
	}

	:root[data-theme='blue-orange'] {
		--accent-primary: #00f5ff;
		--accent-secondary: #ff6b35;
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 2rem;
		background:
			radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--accent-primary) 16%, transparent), transparent 40%),
			radial-gradient(circle at 80% 10%, color-mix(in srgb, var(--accent-secondary) 20%, transparent), transparent 38%),
			var(--bg);
		color: var(--text);
		font-family: 'Press Start 2P', system-ui, monospace;
	}

	.battle-page {
		position: relative;
		width: min(760px, 100%);
		padding: 2rem 1.5rem;
		background: var(--panel);
		border: 2px solid var(--accent-primary);
		box-shadow:
			0 0 16px color-mix(in srgb, var(--accent-primary) 58%, transparent),
			0 0 36px color-mix(in srgb, var(--accent-secondary) 38%, transparent);
		text-align: center;
	}

	.battle-page::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: repeating-linear-gradient(
			to bottom,
			rgba(255, 255, 255, 0.03) 0,
			rgba(255, 255, 255, 0.03) 1px,
			transparent 1px,
			transparent 3px
		);
	}

	h1 {
		margin: 1.2rem 0 1rem;
		line-height: 1.3;
		color: var(--accent-primary);
		text-shadow:
			0 0 8px color-mix(in srgb, var(--accent-primary) 65%, transparent),
			0 0 18px color-mix(in srgb, var(--accent-secondary) 45%, transparent);
	}

	p {
		margin: 0;
		line-height: 1.7;
		font-size: 0.75rem;
		color: color-mix(in srgb, var(--text) 90%, var(--accent-secondary) 10%);
	}

	.theme-toggle {
		position: relative;
		z-index: 1;
		padding: 0.75rem 1rem;
		border: 2px solid var(--accent-secondary);
		background: color-mix(in srgb, var(--bg) 82%, black 18%);
		color: var(--accent-secondary);
		font: inherit;
		font-size: 0.62rem;
		cursor: pointer;
		text-transform: uppercase;
		box-shadow: 0 0 10px color-mix(in srgb, var(--accent-secondary) 45%, transparent);
		transition: transform 150ms ease, box-shadow 150ms ease;
	}

	.theme-toggle:hover,
	.theme-toggle:focus-visible {
		transform: translateY(-2px);
		box-shadow:
			0 0 10px color-mix(in srgb, var(--accent-secondary) 65%, transparent),
			0 0 20px color-mix(in srgb, var(--accent-primary) 45%, transparent);
		outline: none;
	}
</style>
